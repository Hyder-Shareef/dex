DATABASE_URL=sqlite:///./social_agent.db

# Empty LLM_BASE_URL = OpenAI. For a free OpenAI-compatible provider:
# Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/  (model: gemini-flash-latest)
# Groq          : https://api.groq.com/openai/v1                            (model: llama-3.3-70b-versatile)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

CORS_ORIGINS=["http://localhost:5173"]

# Optional: gate the whole app behind a single shared password in production.
SITE_PASSWORD=

# --- Publishing credentials (all optional; a platform stays inactive until set) ---

# Bluesky: free, no app review needed. Create an "app password" at
# https://bsky.app/settings/app-passwords (do NOT use your main account password).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon: free, no app review needed. Create an access token from your instance's
# Development settings (e.g. https://mastodon.social/settings/applications).
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# X/Twitter: requires a paid developer plan. https://developer.x.com/
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# LinkedIn: requires an app approved by LinkedIn for the w_member_social scope.
# https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Meta (Facebook/Instagram): requires an app reviewed by Meta for publishing permissions.
# https://developers.facebook.com/
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
